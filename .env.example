# The local development environment. Copy it to `.env` (Bun loads it
# automatically) and adjust the values for your machine.
#
#   cp .env.example .env
#   docker compose up -d
#   bun run dev

# The master admin credential: `Authorization: API-Key <token>`.
ADMIN_TOKEN=dev-admin-token

# Postgres. Drop the variable to use the in-process PGlite database instead.
DATABASE_URL=postgres://postgres:mysecretpassword@localhost:5432/sentry

# NATS JetStream: the broker every ingestion is published to.
NATS_SERVERS=nats://localhost:4222

# ClickHouse: the event store. `CLICKHOUSE_NATS_URL` is resolved from
# ClickHouse's point of view, not the API's.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_NATS_URL=localhost:4222

# The object store (RustFS in the compose file). The replay segments are
# offloaded here; there is no local-disk fallback.
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=sentry-replays
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin

# The UI live feed subscribes to NATS over WebSocket. The browser derives
# `ws://<host>:9222` from the page URL; a deployment injects its own
# endpoint through `globalThis.__NATS_WS_URL__`.

# An OIDC provider (optional). Without it the admin token is the only
# credential.
# OIDC_ISSUER=https://id.acme.io
# OIDC_CLIENT_ID=benedebug
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
